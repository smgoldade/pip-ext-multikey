{
    "name": "pip-ext-multikey",
    "version": "1.8.0",
    "private": true,
    "description": "Keeps several API keys for one provider in Pi Pocket, so a key that is spent, refused, or rate-limited never stops the work.",
    "author": "Steven Goldade",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/smgoldade/pip-ext-multikey.git"
    },
    "homepage": "https://github.com/smgoldade/pip-ext-multikey",
    "type": "module",
    "keywords": [
        "pi-pocket",
        "pi-pocket-extension",
        "api-keys",
        "key-rotation"
    ],
    "scripts": {
        "test": "node --test test/",
        "check": "tsc --noEmit --allowImportingTsExtensions --module nodenext --moduleResolution nodenext --target es2023 --strict --skipLibCheck multikey.ts _multikey-policy.ts _multikey-probes.ts"
    },
    "devDependencies": {
        "typescript": "^5.7.2"
    }
}
